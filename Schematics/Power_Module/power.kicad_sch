				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cee6f456-0141-43f7-ae81-772523dc20e7")
	)
	(text_box "Constants:\nT = 1/500000\nVin = 24V\nVout = 3.3V\nD = 3.3/24 = 0.1375\n\nP = 0.5W (estimate with one module powered)\nLcrit = 0.5*(1-0.1375)*(3.3^2/0.5)*(1/500000) = 18.79uH\n\nPo = 3W (estimate of all 3.3V modules)\nLcrit = 0.5*(1-0.1375)*(3.3^2/3)*(1/500000) = 3.13uH\n\ndelta_IL = 0.3*(3/3.3) = 0.273A\nL = 3.3*(1-0.1375)/(500000*0.273) = 20.85uH\nILmax = (3/3.3) + 0.5*0.273 = 1.05A\n\n\nChose 27uH Inductor, ILmax = 3.6A, tolerance = 20%\ndelta_IL_max = 3.3*(1-0.1375)/(500000*(1-.2)*27*10^-6) = 0.27A\ndelta_Vo = 2%*3.3 = 0.066V\nC = 0.27/(8*500000*0.066) = 1uF"
		(exclude_from_sim no)
