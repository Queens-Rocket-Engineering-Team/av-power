	(text_box "Constants:\nT = 1/500000\nVin = 24V\nVout = 5\nD = 5/24\n\nP = 0.2W\nLcrit = 0.5(1-0.2083)(5^2/0.2)*(1/500000) = 99uH\n\nP=1W (typical with RF transmition)\nLcrit = 0.5(1-0.2083)(5^2/1)*(1/500000) = 20uH\n\ndelta IL = 0.3(1/5) = 0.06A\nL = 5(1-0.2083)(1/500000)/(0.06) = 132uH\nILmax = (1/5) + 0.5*(0.06) = 0.23A\n\nChose Inductor 120uH, ILmax = 1.65A, tolerance = 10%\ndelta_IL_max = 5*(1-0.2083)/(500000*(1-.1)*120*10^-6) = 0.073A\ndelta_Vo = 2%*5 = 0.1V\nC = 0.08/(8*500000*0.1) = 0.2uF"
		(exclude_from_sim no)
		(at -80.645 93.345 0)
		(size 70.5612 45.085)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24d11349-768c-431f-b6e6-0c8b2beae99e")
	)
	(text_box "Vout = 1.229V*(R1/R2 + 1)\n(cause they jlcpcb basic)\nR1 = 220K, R2 = 12k, \nVout = 1.229*(220/12 + 1) = 23.76V"
		(exclude_from_sim no)
		(at 200.025 160.02 0)
		(size 40.64 9.525)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4dd546b2-5c00-4ef6-9e96-8472041f80a7")
	)
	(text_box "Buck Design Equations:\nD = Vo/Vin\n\nLcrit = 0.5*(1-D)*R*T\n\ndelta_IL = 30% of Io  (design choice)\n\nL = Vo*(1-D)*T / delta_IL\n\nILmax = Io + 0.5*delta_IL\n\ndelta_Vo = 2% of Vo  (design choice)\n\nC = delta_IL * T / (8 * delta_Vo)"
		(exclude_from_sim no)
		(at -80.645 8.255 0)
		(size 66.675 36.195)
		(margins 1.1557 1.1557 1.1557 1.1557)
		(stroke
			(width 0.0254)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9cbd73e1-9af5-498e-8e93-9e270ee9feee")
	)
	(text_box "Equations:\nVin/Vo = 1-D\nT = 1/F\nRo = Vo^2/Po\nIin = Vin/(Ro(1-D)^2) = Po/(0.9*Vin) assume 10% V loss\ndetla_IL = 30% of IL\nL = VinDT/delta_IL\nLcrit = RT/2(1-D)^2D (when IL = 0)\nIL_max = Iin + 1/2(delta_IL)\ndelta_Vc = VoDT/RC\nID_avg = Iin(1-D)\nId_max = IL_max\nVc_max = Vo\nIc_rms = sqrt(DIin^2 + (1-D)(Iin - Io)^2) \n\n\nConstants:\nF = 200KHz to 2.2MHz (Choose lowest frequency feasable, smaller F -> large L and C)\nVin_max = 12.6V\nVin_nominal = 11.1V\nVin_min = 7.5V\nVo = 23.76V ~ 24V (based on feedback Resisters)\nPo_max = 10W\nIo_max = 500mA\nPo_min = 1W\nIo_min = 40mA\nD_max = 1 - 7.5/24 = 0.6875\nD_min = 1 - 12.6/24 = 0.475\n\n\nBest Case:\nVin = 7.5, Po = 10W\nIin = 7.5/((24^2/10)(7.5/24)^2) = 1.33333333 A\n\n\nWorst Case:\nVin = 12.6, Po = 1W\nIin = 12.6/((24^2/1)(12.6/24)^2) = 0.079365079 A\n\n\n\n1-D = Vin/Vo = 12.6/24 = 0.525\nD = 0.475\n\nF = 10^6 Hz\nT = 1/F = 1×10^-6 s\n\nRo = 24^2 / 1 = 576 Ω\n\nIin = Po / Vin = 1 /(0.9*12.6) = 0.08818 A\n\ndelta_IL = 0.3 × 0.08818 = 0.02646 A\n\nL = (12.6 × 0.475 × 1×10^-6) / 0.02646 = 2.26×10^-4 H = 226 µH\n\nLcrit = (576 × 1×10^-6 / 2) × (0.525^2) × 0.475 = 3.77×10^-5 H = 37.7 µH\n\nIL_max = 0.08818 + 0.5(0.02646) = 0.1014 A\n\nΔVc = Vo × D × T / (Ro × C)=\nAssume ripple = 2% Vo\nΔVc = 0.48 V\n\nC = Vo × D × T / (Ro × ΔVc)\nC = (24 × 0.475 × 1×10^-6) / (576 × 0.48) = 41.2×10^-9 F =  41.2 nF\n\nID_avg = 0.08818 × 0.525 = 0.0463 A\n\nID_max = IL_max = 0.1014 A\n\nIo = 1 / 24 = 0.04167 A\n\nIc_rms = sqrt(0.475(0.08818)^2 + 0.525(0.08818 - 0.04167)^2) = 0.0695 A\n"
		(exclude_from_sim no)
		(at 241.0714 117.1702 0)
		(size 58.166 164.7698)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
