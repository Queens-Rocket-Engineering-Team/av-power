	(text_box "Constants:\nT = 1/500000\nVin = 24V\nVout = 5\nD = 5/24\n\nP = 0.2W\nLcrit = 0.5(1-0.2083)(5^2/0.2)*(1/500000) = 99uH\n\nP=1W (typical with RF transmition)\nLcrit = 0.5(1-0.2083)(5^2/1)*(1/500000) = 20uH\n\ndelta IL = 0.3(1/5) = 0.06A\nL = 5(1-0.2083)(1/500000)/(0.06) = 132uH\nILmax = (1/5) + 0.5*(0.06) = 0.23A\n\nChose Inductor 130uH, ILmax = 1A\ndelta_IL = 5(1-0.2083)/(500000*130*10^-6) = 0.061A\ndelta_Vo = 2%*5 = 0.1V\nC = 0.061/(8*500000*0.1) = 0.15uF"
		(exclude_from_sim no)
		(at -80.645 93.345 0)
		(size 55.88 45.085)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "24d11349-768c-431f-b6e6-0c8b2beae99e")
	)
	(text_box "Vout = 1.229V*(R1/R2 + 1)\n(cause they jlcpcb basic)\nR1 = 220K, R2 = 12k, \nVout = 1.229*(220/12 + 1) = 23.76V"
		(exclude_from_sim no)
		(at 194.945 160.02 0)
		(size 40.64 9.525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4dd546b2-5c00-4ef6-9e96-8472041f80a7")
	)
	(text_box "Buck Design Equations:\nD = Vo/Vin\n\nLcrit = 0.5*(1-D)*R*T\n\ndelta_IL = 30% of Io  (design choice)\n\nL = Vo*(1-D)*T / delta_IL\n\nILmax = Io + 0.5*delta_IL\n\ndelta_Vo = 2% of Vo  (design choice)\n\nC = delta_IL * T / (8 * delta_Vo)"
		(exclude_from_sim no)
		(at -80.645 8.255 0)
		(size 66.675 36.195)
		(stroke
			(width 0.0254)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "9cbd73e1-9af5-498e-8e93-9e270ee9feee")
	)
	(text_box "Equations:\nD = 1 - Vin/Vo\nT = 1/F\nIin = Vin/(R(1-D)^2)\ndetla_IL = 30% of IL\nL = VinDT/L\nLcrit = RT/2(1-D)^2D (when IL = 0)\nIL_max = Iin + 1/2(delta_IL)\ndelta_Vc = VoDT/RC\nID_avg = Iin(1-D)\nId_max = IL_max\nVc_max = Vo\nIc_rms = sqrt(DIin^2 + (1-D)(Iin - Io) \n\n\nConstants:\nF = 200KHz to 2.2MHz (Choose lowest frequency feasable, smaller F -> large L and C)\nVin_max = 12.6V\nVin_nominal = 11.1V\nVin_min = 7.5V\nVo = 23.76V ~ 24V\nPo_max = 10W\nPo_min = 1W\nD_max = 1 - 7.5/24\nD_min = 1 - 12.6/24\n\n\n\n"
		(exclude_from_sim no)
		(at 251.8918 169.164 0)
		(size 58.166 61.7982)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cee6f456-0141-43f7-ae81-772523dc20e7")
	)
	(text_box "Constants:\nT = 1/500000\nVin = 24V\nVout = 3.3V\nD = 3.3/24 = 0.1375\n\nP = 0.5W (estimate with one module powered)\nLcrit = 0.5*(1-0.1375)*(3.3^2/0.5)*(1/500000) = 18.79uH\n\nPo = 3W (estimate of all 3.3V modules)\nLcrit = 0.5*(1-0.1375)*(3.3^2/3)*(1/500000) = 3.13uH\n\ndelta_IL = 0.3*(3/3.3) = 0.273A\nL = 3.3*(1-0.1375)/(500000*0.273) = 20.85uH\nILmax = (3/3.3) + 0.5*0.273 = 1.05A\n\n\nChose 27uH Inductor, ILmax = 3.6A \ndelta_IL = 3.3*(1-0.1375)/(500000*27*10^-6) = 0.21A\ndelta_Vo = 2%*3.3 = 0.066V\nC = 0.21/(8*500000*0.066) = 0.80uF"
		(exclude_from_sim no)
		(at -81.28 46.99 0)
		(size 62.23 44.45)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ed7101e8-38fd-489c-94cc-b5c9fd52930e")
	)
